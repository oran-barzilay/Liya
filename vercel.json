{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [{ "source": "/((?!api|_next|assets|favicon).*)", "destination": "/index.html" }],
  "crons": [
    { "path": "/api/daily?slot=summer", "schedule": "0 4 * * *" },
    { "path": "/api/daily?slot=winter", "schedule": "0 5 * * *" }
  ]
}
